# Copier ce fichier vers .env pour le développement local.
# Ne jamais committer .env ni une valeur secrète réelle.

# --- Serveur (privé) ---
# MySQL/Drizzle : remplacer les valeurs entre chevrons.
DATABASE_URL=mysql://<user>:<password>@<host>:3306/<database>
NODE_ENV=development
PORT=3000

# OAuth et sessions Manus (actuellement utilisés par server/_core/oauth.ts et sdk.ts)
MANUS_PROJECT_ID=
MANUS_OAUTH_API_URL=
MANUS_OAUTH_PORTAL_URL=
# Secret serveur : ne jamais l'exposer dans EXPO_PUBLIC_*.
MANUS_JWT_SECRET=

# --- Client Expo (public) ---
# Les valeurs MANUS_* ci-dessus sont recopiées vers EXPO_PUBLIC_* par scripts/load-env.js.
# Ne renseigner ici que des valeurs publiques.
EXPO_PUBLIC_API_BASE_URL=

# --- Intégrations Manus optionnelles ---
# Utilisées par le proxy de stockage, les notifications propriétaire ou les modules actuellement non branchés.
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# --- Tests et paramètres métier optionnels ---
# BARAHUB_TEST_DATABASE_URL=mysql://<user>:<password>@<host>:3306/<test_database>
# BARAHUB_COMMISSION_RATE_BPS=1500
